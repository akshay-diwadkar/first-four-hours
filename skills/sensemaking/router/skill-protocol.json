{
  "protocol_version": "1.0.0",
  "mode": "stateless",
  "skill": "router",
  "minimum_python": "3.11",
  "run_dir_policy": "outside_skill_and_repo",
  "requirements": [],
  "inputs": [
    {"name": "draft", "kind": "path", "required": true, "repeatable": false, "description": "Agent-authored route draft outside the target repository.", "choices": []},
    {"name": "slug", "kind": "string", "required": true, "repeatable": false, "description": "Route workspace slug; the command seals only ignored .first-four-hours/routes/<slug>/route.md in the target repository.", "choices": []}
  ],
  "artifacts": [],
  "phases": {},
  "commands": {
    "run": {
      "allowed_phases": [],
      "success_phase": null,
      "allowed_writes": ["{repo_root}/.first-four-hours/routes", "{repo_root}/.git/info/exclude"],
      "steps": [
        {
          "argv": ["{python}", "{skill_dir}/scripts/seal_route.py", "--repo-root", "{repo_root}", "--draft", "{input.draft}", "--slug", "{input.slug}"],
          "repeat": [],
          "capture_stdout": null,
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    }
  }
}
