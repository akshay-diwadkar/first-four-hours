{
  "protocol_version": "1.0.0",
  "mode": "stateless",
  "skill": "atlas",
  "minimum_python": "3.11",
  "run_dir_policy": "outside_skill",
  "requirements": [],
  "inputs": [
    {
      "name": "cycle_fingerprint",
      "kind": "string",
      "required": false,
      "required_for": ["baseline"],
      "accepted_for": ["baseline"],
      "repeatable": false,
      "description": "Cycle returned by check.",
      "choices": []
    },
    {
      "name": "reviewed_satellite",
      "kind": "string",
      "required": false,
      "accepted_for": ["baseline"],
      "repeatable": true,
      "description": "Reviewed Satellite path.",
      "choices": []
    },
    {
      "name": "acknowledged_unmapped",
      "kind": "string",
      "required": false,
      "accepted_for": ["baseline"],
      "repeatable": true,
      "description": "Reviewed unmapped path.",
      "choices": []
    },
    {
      "name": "acknowledge_unmapped",
      "kind": "choice",
      "required": false,
      "accepted_for": ["baseline"],
      "repeatable": false,
      "description": "Acknowledge exactly the unmapped obligations of the supplied cycle.",
      "choices": ["all"]
    }
  ],
  "artifacts": [],
  "phases": {},
  "commands": {
    "run": {
      "allowed_phases": [],
      "success_phase": null,
      "steps": [
        {
          "argv": ["{python}", "{skill_dir}/scripts/structure_state.py", "--repo-root", "{repo_root}"],
          "repeat": [],
          "capture_stdout": null,
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    },
    "check": {
      "allowed_phases": [],
      "success_phase": null,
      "steps": [
        {
          "argv": ["{python}", "{skill_dir}/scripts/freshness_state.py", "--repo-root", "{repo_root}", "--operation", "check"],
          "repeat": [],
          "capture_stdout": null,
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    },
    "baseline": {
      "allowed_phases": [],
      "allowed_writes": ["{repo_root}/.map/.state/freshness.json"],
      "success_phase": null,
      "steps": [
        {
          "argv": ["{python}", "{skill_dir}/scripts/freshness_state.py", "--repo-root", "{repo_root}", "--operation", "baseline", "--cycle-fingerprint", "{input.cycle_fingerprint}"],
          "repeat": [
            {"input": "reviewed_satellite", "flag": "--reviewed-satellite"},
            {"input": "acknowledged_unmapped", "flag": "--acknowledged-unmapped"},
            {"input": "acknowledge_unmapped", "flag": "--acknowledge-unmapped"}
          ],
          "capture_stdout": null,
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    },
    "setup-guidance": {
      "allowed_phases": [],
      "allowed_writes": ["{repo_root}/AGENTS.md", "{repo_root}/CLAUDE.md"],
      "success_phase": null,
      "steps": [
        {
          "argv": ["{python}", "{skill_dir}/scripts/repository_guidance.py", "--repo-root", "{repo_root}", "--operation", "setup"],
          "repeat": [],
          "capture_stdout": null,
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    },
    "remove-guidance": {
      "allowed_phases": [],
      "allowed_writes": ["{repo_root}/AGENTS.md", "{repo_root}/CLAUDE.md"],
      "success_phase": null,
      "steps": [
        {
          "argv": ["{python}", "{skill_dir}/scripts/repository_guidance.py", "--repo-root", "{repo_root}", "--operation", "remove"],
          "repeat": [],
          "capture_stdout": null,
          "diagnostics_json": true,
          "failure": "blocked"
        }
      ]
    }
  }
}
